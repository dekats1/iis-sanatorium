# Скопировать в .env и заменить значения. .env в git не коммитится.
POSTGRES_PASSWORD=postgres
# Общий секрет подписи JWT (HS256) для gateway, core-service и pricing-forecast (в compose передаётся всем трём): не короче 32 байт
JWT_SECRET=replace-with-random-string-at-least-32-bytes
# Ключ вызова платёжного эмулятора и секрет подписи его вебхуков
PAYMENT_API_KEY=replace-me
PAYMENT_WEBHOOK_SECRET=replace-with-random-string-at-least-32-bytes
# demo — загрузить демонстрационные справочники и пользователей; пусто — не загружать
CORE_PROFILE=demo
